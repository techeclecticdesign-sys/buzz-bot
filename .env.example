# Bot token from https://discord.com/developers/applications -> your app -> Bot -> Reset Token
DISCORD_TOKEN=your-bot-token-here

# Postgres connection string from Neon (https://neon.tech) -> your project -> Connect
# Looks like: postgresql://user:password@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=

# Right-click your log channel in Discord (with Developer Mode on) -> Copy Channel ID
# Only required when LOGGING_ENABLED is not "false".
LOG_CHANNEL_ID=

# --- Feature flags ---
# Game (Mafia Wars-style daily RPG): slash commands, needs no privileged intents.
# The bot must be invited with the applications.commands scope for the slash
# commands to appear. Set "false" to disable. Default: true.
GAME_ENABLED=true

# Anonymous timed polls: /poll and /closepoll. Uses buttons, so votes are not
# visible publicly; final totals are posted when the poll closes. Default: true.
POLLS_ENABLED=true

# /verify-adult: an age-restricted (NSFW) slash command. Discord only shows it to
# members its age assurance has as 18+, and only in age-restricted channels.
# Each use posts the member's name to ADULT_CHECK_CHANNEL_ID. Default: true.
ADULT_CHECK_ENABLED=true
# Channel that receives the /verify-adult posts. Default: 1534208635889123548.
ADULT_CHECK_CHANNEL_ID=

# --- Discord questionnaire -> Google Sheets ---
# Posts matching the :user: mention line + ### question / answer format in this
# channel are sent as structured JSON to a Google Apps Script web app. The
# integration stays off until BOTH values below are set. Keep the secret long
# and random; it prevents strangers who find the web-app URL from writing rows.
SURVEY_SUBMISSION_CHANNEL_ID=1534208635889123548
SURVEY_SHEETS_WEB_APP_URL=
SURVEY_SHEETS_SHARED_SECRET=

# Logging (message archive + edit/delete embeds + member/name tracking). Optional
# so the bot can run game-only: when "false", LOG_CHANNEL_ID is not required.
# Message/member intents are still needed by enabled features such as the
# failsafe and member-age tracking. Default: true.
LOGGING_ENABLED=true

# Optional: channel where the game posts public shout-outs for big crime scores
# and won attacks. Leave unset to keep the game silent (ephemeral only).
GAME_ANNOUNCE_CHANNEL_ID=
# Minimum crime payout to announce publicly. Default: 10000.
GAME_ANNOUNCE_CRIME_MIN=10000

# --- Command role gates ---
# Roles allowed to run moderation commands like c!threadkill.
MOD_ROLES=300831005621878784,322845008409395200,479484736188973087

# Roles allowed to create polls.
STAFF_ROLES=300831005621878784,322845008409395200,479484736188973087,1371346095380238376,1376679985603022899

# Optional: set to "true" to stop archiving/logging messages from other bots.
# Bots like YAGPDB edit their own messages constantly (paginated embeds etc.),
# which can flood the edit log. Default: false (bots are logged).
IGNORE_BOTS=true

# Optional: comma-separated channel IDs to skip entirely — no archive, no
# edit/delete/bulk-delete embeds, and skipped by the backfill. Listing a
# category ID excludes every channel under it; listing a text-channel ID also
# excludes its threads. (Right-click a channel/category with Developer Mode on
# -> Copy Channel ID.) Member/name/role logging isn't channel-scoped and still
# runs. Leave unset to log every channel. Example: IGNORE_CHANNELS=123,456
IGNORE_CHANNELS=1525538633568882963

# Optional: comma-separated channel and/or category IDs scanned for dead Discord
# invite links. A category ID includes every channel under it (and their
# threads), same as IGNORE_CHANNELS. Scope this to the group advert channels/
# category — not the whole server. Used by both `npm run check-links` and the
# running bot's daily in-process sweep.
LINK_CHECK_CHANNELS=

# Optional: channel where check-links posts one notification per dead-link
# post, pinging the author with a jump link to their post (e.g.
# #rule_infractions). Leave unset for a console-only report. Note that
# re-running the script re-notifies posts that are still standing.
LINK_CHECK_NOTIFY_CHANNEL_ID=

# Optional: how often (minutes) the running bot re-checks posts that are ALREADY
# flagged for a dead link, between the once-a-day full scans. This is cheap — it
# only re-tests the handful of flagged posts, scanning no channels — so a member
# who fixes a link, or whose grace window elapses, is picked up within the hour
# instead of waiting for the next daily sweep. Only active when grace deletion is
# on (LINK_CHECK_GRACE_HOURS > 0). Clamped to a 15-minute minimum. Default: 60.
LINK_CHECK_PENDING_MINS=60

# --- Database retention (prune the local message archive so storage stays
# bounded). This ONLY deletes rows from the bot's own database — it never
# deletes anything from Discord. ---

# Optional: set to "false" to disable retention pruning and keep the archive
# forever (watch your Neon storage). Default: true (pruning on).
DB_RETENTION_ENABLED=true

# Optional: how long an advert-channel message row is kept in the database
# before the daily prune deletes it, in days. The advert channels are the ones
# configured in src/advertConfig.live.js / .test.js. Default: 365 (one year).
ADVERT_RETENTION_DAYS=365

# Optional: how long every OTHER channel's message rows are kept in the
# database, in days. Default: 730 (two years).
MESSAGE_RETENTION_DAYS=730

# Optional: local JSON backup. When set, every archived message and every
# edit/delete event is also appended to <dir>/<guildId>/<channel>.jsonl.
# Leave unset on the bot host; set locally for an offline copy.
JSON_ARCHIVE_DIR=

# --- Failsafe (takes over YAGPDB's automation while YAGPDB is offline) ---

# The failsafe watches whether the YAGPDB bot ("Jarvis") is online. Detecting
# that needs the privileged PRESENCE INTENT — enable it in the Developer Portal
# (Bot tab -> Privileged Gateway Intents -> Presence Intent) or the bot won't
# start. Set to "false" to disable the failsafe AND drop the Presence intent
# (use this if you can't/won't enable that intent). Default: true.
FAILSAFE_ENABLED=true

# Role assigned to members on join while YAGPDB is offline. Default: RPC's
# "Age Please" gate role.
AGE_PLEASE_ROLE_ID=

# Optional: comma-separated known YAGPDB bot user IDs. IDs never change, so
# pinning them is the most reliable match; otherwise any online bot whose name
# contains "yagpdb" (ignoring the #discriminator) is treated as YAGPDB.
YAGPDB_BOT_IDS=

# Which advert-channel config the advert failsafe uses. Set to "test" on the
# test-server deployment; unset (or anything else) uses the live config. Channel
# IDs live in src/advertConfig.live.js and src/advertConfig.test.js.
ADVERT_ENV=live

# How long YAGPDB must be continuously offline before the advert failsafe starts
# deleting posts (and before the onboarding failsafe kicks an underage member).
# Guards against acting on a brief reconnect blip. Default: 60.
ADVERT_MIN_OFFLINE_SECS=60

# Re-run the advert content checks (length + advisory) when an ad is EDITED.
# YAGPDB's free tier can't trigger commands on edits, so this closes the gap
# where a member edits a clean ad into a rule-breaking one. Unlike the failsafe
# it runs whether or not YAGPDB is online (that's the point). On by default when
# advert channels are configured; set to false to disable. Cooldown/duplicate
# checks are intentionally skipped on edits (they're posting-frequency rules).
ADVERT_EDIT_CHECKS=true

# --- Onboarding failsafe (age verification + rules reaction, while YAGPDB is
# offline). Reproduces YAGPDB's gate: age in the verification channel advances
# Age Please -> Rules Please; reacting to the rules message advances
# Rules Please -> Newbie. The whole thing is DORMANT until you set the age
# channel below (like the advert failsafe with no channels). Needs the Presence
# intent (shared with the rest of the failsafe) plus Manage Roles and, for the
# underage kick, Kick Members — with the bot's highest role above these gate
# roles / the members it kicks. ---

# Channel where members type their age. Unset = onboarding failsafe off.
# Right-click the age-verification channel (Developer Mode on) -> Copy Channel ID.
# For the TEST server, the age_verification channel is 1520827328324702430
# (from the archive). Set the live channel id here for the live deployment.
AGE_VERIFY_CHANNEL_ID=

# Persist exact two-digit ages 15-99 from the age channel (independent of the
# archive and YAGPDB). When AGE_VERIFY_CHANNEL_ID is blank this feature uses
# live channel 735579435000004747; the onboarding failsafe stays off when blank.
# Needs Guild Members + Message Content intents and View Channel / Read Message
# History. Backfills on startup; manual full scan: npm run backfill:ages.
# Stores only age, statement timestamp and message id on member_state. Leaving
# removes that record, and startup reconciles departures missed while offline.
MEMBER_AGES_ENABLED=true

# Gate roles (defaults are RPC's live IDs). AGE_PLEASE_ROLE_ID is set above.
RULES_PLEASE_ROLE_ID=
NEWBIE_ROLE_ID=

# Server-rules message and the reaction that agrees to the rules.
RULES_MESSAGE_ID=
RULES_EMOJI_ID=
RULES_EMOJI_NAME=

# Accepted age range. A member who enters an age below MIN_AGE is kicked
# (matching YAGPDB); MIN_AGE is the only control for that. Above MAX_AGE they get
# a "two-digit age" warning embed. Defaults: 15 and 75.
MIN_AGE=15
MAX_AGE=75

# --- AI advert keywords (src/advertLabeller.js) ---
# From LABEL_HOUR (8am US Eastern) each day, adverts with no keywords yet are sent
# in batches to a Claude Code routine, which labels them (14 categories + fandoms
# + optional self-stated author age; prompt: docs/advert-labeller-routine.md)
# and writes the labels straight into the database through the
# submit_advert_labels() function. Identical text is never sent twice; edited text
# is. A failure ends that day's run and the rest waits for tomorrow. Runs use the
# routine owner's Claude subscription usage.
# Manual: npm run label:dry | npm run label:once -- --limit 5 | npm run label:status

# Off unless "true".
LABEL_ENABLED=false
# "true" = build the day's first batch and log its ids and size, fire nothing.
LABEL_DRY_RUN=false

# From claude.ai/code/routines -> the routine -> Edit -> API trigger. ROUTINE_ID is
# the trig_... part of the URL. The token (sk-ant-oat01-...) is shown once;
# regenerating it revokes the old one. Never commit or share it.
ROUTINE_ID=
ROUTINE_TOKEN=
# The fire API's dated beta header. "none" = send none (the API's latest shape).
# ROUTINE_BETA=experimental-cc-routine-2026-04-01

# A long random secret the routine sends as x-labeller-token when it submits
# labels. The SAME value goes in the routine's cloud environment (as a network
# secret). The bot stores only its sha256 in the database, at boot. Generate:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
LABELLER_TOKEN=
# Only for the one-time header check (curl as the routine calls it). Supabase ->
# Project Settings -> API Keys -> Publishable key. Not a secret.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# Must match the routine prompt's version. Default: rpc14-v1.
LABEL_PROMPT_VERSION=rpc14-v1
# Hour (0-23, US Eastern) the daily run starts. Default: 8.
LABEL_HOUR=8
# Max bytes of one batch's text (the API caps it at 65,536). Default: 60000 (~45 ads).
LABEL_BATCH_MAX_BYTES=60000
# Max batches per day. The API allows 30 per routine per hour. Default: 30.
LABEL_MAX_RUNS_PER_DAY=30
# A batch the routine hasn't submitted after this many hours is expired. Default: 3.
LABEL_STALE_HOURS=3
# Give up on an ad after this many batches that left it unlabelled. Default: 3.
LABEL_MAX_ATTEMPTS=3
# Optional channel-id override; unset = the 11 browse channels in advertConfig.
LABEL_CHANNELS=
# Same-fandom report: once a day's run is over, this channel gets one line per
# pair of standing adverts by one poster that share a fandom (@poster, link to the
# newer ad, link to the older). Mentions don't ping. Empty = off. Default: #bot_spam.
FANDOM_REPORT_CHANNEL_ID=406618336508510209
# Comma-separated user ids pinged at the top of each same-fandom report.
ADREVIEWERS=962175556055617546,671760757679194231,1437254314434232330
# Optional channel-id override for the adverts it compares; unset = the six
# one-on-one channels (long-form, 18+ and quick; not the group channels).
FANDOM_REPORT_ADVERT_CHANNELS=
# Days a label is kept once its advert is gone (deleted on Discord or pruned), so
# a repost of the same text within that time reuses it instead of being scanned
# again. Labels of standing adverts are kept; the batch log is kept as long. Part
# of the daily retention prune (off with DB_RETENTION_ENABLED=false). Default: 90.
LABEL_RETENTION_DAYS=90

# --- rpc-web cache purge (src/sitePurge.js) ---
# rpc-web caches its pages for signed-out visitors (ad pages for a week). When an
# advert is posted, edited, reacted to or deleted, the bot tells rpc-web which, so
# it refreshes that ad's page and the genre and fandom pages listing it. Once a
# day it refreshes every genre and fandom page. Off unless both are set.
RPC_WEB_URL=
# The same random secret as rpc-web's ADVERT_PURGE_SECRET (32+ characters).
ADVERT_PURGE_SECRET=
# Hour (0-23, UTC) of the daily genre/fandom refresh, after the label run. Default: 16.
SITE_PURGE_DAILY_UTC_HOUR=16
