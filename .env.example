# Bot token from https://discord.com/developers/applications -> your app -> Bot -> Reset Token
DISCORD_TOKEN=your-bot-token-here

# Postgres connection string from Neon (https://neon.tech) -> your project -> Connect
# Looks like: postgresql://user:password@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=

# Right-click your log channel in Discord (with Developer Mode on) -> Copy Channel ID
# Only required when LOGGING_ENABLED is not "false".
LOG_CHANNEL_ID=

# --- Feature flags ---
# Game (Mafia Wars-style daily RPG): slash commands, needs no privileged intents.
# The bot must be invited with the applications.commands scope for the slash
# commands to appear. Set "false" to disable. Default: true.
GAME_ENABLED=true

# Anonymous timed polls: /poll and /closepoll. Uses buttons, so votes are not
# visible publicly; final totals are posted when the poll closes. Default: true.
POLLS_ENABLED=true

# Logging (message archive + edit/delete embeds + member/name tracking). Optional
# so the bot can run game-only: when "false", LOG_CHANNEL_ID and the privileged
# message/member intents are not requested. Default: true.
LOGGING_ENABLED=true

# Optional: channel where the game posts public shout-outs for big crime scores
# and won attacks. Leave unset to keep the game silent (ephemeral only).
GAME_ANNOUNCE_CHANNEL_ID=
# Minimum crime payout to announce publicly. Default: 10000.
GAME_ANNOUNCE_CRIME_MIN=10000

# Optional: set to "true" to stop archiving/logging messages from other bots.
# Bots like YAGPDB edit their own messages constantly (paginated embeds etc.),
# which can flood the edit log. Default: false (bots are logged).
IGNORE_BOTS=true

# Optional: comma-separated channel IDs to skip entirely — no archive, no
# edit/delete/bulk-delete embeds, and skipped by the backfill. Listing a
# category ID excludes every channel under it; listing a text-channel ID also
# excludes its threads. (Right-click a channel/category with Developer Mode on
# -> Copy Channel ID.) Member/name/role logging isn't channel-scoped and still
# runs. Leave unset to log every channel. Example: IGNORE_CHANNELS=123,456
IGNORE_CHANNELS=1525538633568882963

# Optional: comma-separated channel and/or category IDs that `npm run
# check-links` scans for dead Discord invite links. A category ID includes
# every channel under it (and their threads), same as IGNORE_CHANNELS.
# Only used by that script; the running bot ignores it.
LINK_CHECK_CHANNELS=

# Optional: channel where check-links posts one notification per dead-link
# post, pinging the author with a jump link to their post (e.g.
# #rule_infractions). Leave unset for a console-only report. Note that
# re-running the script re-notifies posts that are still standing.
LINK_CHECK_NOTIFY_CHANNEL_ID=

# --- Database retention (prune the local message archive so storage stays
# bounded). This ONLY deletes rows from the bot's own database — it never
# deletes anything from Discord. ---

# Optional: set to "false" to disable retention pruning and keep the archive
# forever (watch your Neon storage). Default: true (pruning on).
DB_RETENTION_ENABLED=true

# Optional: how long an advert-channel message row is kept in the database
# before the daily prune deletes it, in days. The advert channels are the ones
# configured in src/advertConfig.live.js / .test.js. Default: 365 (one year).
ADVERT_RETENTION_DAYS=365

# Optional: how long every OTHER channel's message rows are kept in the
# database, in days. Default: 730 (two years).
MESSAGE_RETENTION_DAYS=730

# Optional: local JSON backup. When set, every archived message and every
# edit/delete event is also appended to <dir>/<guildId>/<channel>.jsonl.
# Leave unset on the bot host; set locally for an offline copy.
JSON_ARCHIVE_DIR=

# --- Failsafe (takes over YAGPDB's automation while YAGPDB is offline) ---

# The failsafe watches whether the YAGPDB bot ("Jarvis") is online. Detecting
# that needs the privileged PRESENCE INTENT — enable it in the Developer Portal
# (Bot tab -> Privileged Gateway Intents -> Presence Intent) or the bot won't
# start. Set to "false" to disable the failsafe AND drop the Presence intent
# (use this if you can't/won't enable that intent). Default: true.
FAILSAFE_ENABLED=true

# Role assigned to members on join while YAGPDB is offline. Default: RPC's
# "Age Please" gate role.
AGE_PLEASE_ROLE_ID=735544386678554738

# Optional: comma-separated known YAGPDB bot user IDs. IDs never change, so
# pinning them is the most reliable match; otherwise any online bot whose name
# contains "yagpdb" (ignoring the #discriminator) is treated as YAGPDB.
YAGPDB_BOT_IDS=

# Which advert-channel config the advert failsafe uses. Set to "test" on the
# test-server deployment; unset (or anything else) uses the live config. Channel
# IDs live in src/advertConfig.live.js and src/advertConfig.test.js.
ADVERT_ENV=live

# How long YAGPDB must be continuously offline before the advert failsafe starts
# deleting posts (and before the onboarding failsafe kicks an underage member).
# Guards against acting on a brief reconnect blip. Default: 60.
ADVERT_MIN_OFFLINE_SECS=60

# --- Onboarding failsafe (age verification + rules reaction, while YAGPDB is
# offline). Reproduces YAGPDB's gate: age in the verification channel advances
# Age Please -> Rules Please; reacting to the rules message advances
# Rules Please -> Newbie. The whole thing is DORMANT until you set the age
# channel below (like the advert failsafe with no channels). Needs the Presence
# intent (shared with the rest of the failsafe) plus Manage Roles and, for the
# underage kick, Kick Members — with the bot's highest role above these gate
# roles / the members it kicks. ---

# Channel where members type their age. Unset = onboarding failsafe off.
# Right-click the age-verification channel (Developer Mode on) -> Copy Channel ID.
# For the TEST server, the age_verification channel is 1520827328324702430
# (from the archive). Set the live channel id here for the live deployment.
AGE_VERIFY_CHANNEL_ID=

# Gate roles (defaults are RPC's live IDs). AGE_PLEASE_ROLE_ID is set above.
RULES_PLEASE_ROLE_ID=634585076524646401
NEWBIE_ROLE_ID=456657052136243210

# Server-rules message and the reaction that agrees to the rules.
RULES_MESSAGE_ID=1385675552601411605
RULES_EMOJI_ID=658510846779195423
RULES_EMOJI_NAME=rpc

# Accepted age range. A member who enters an age below MIN_AGE is kicked
# (matching YAGPDB); MIN_AGE is the only control for that. Above MAX_AGE they get
# a "two-digit age" warning embed. Defaults: 15 and 75.
MIN_AGE=15
MAX_AGE=75
