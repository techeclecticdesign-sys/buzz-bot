{
  "name": "rpc-logger-bot",
  "version": "1.0.0",
  "description": "Discord message archive + edit/delete logging bot with permanent database storage",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "test": "node --test \"src/**/*.spec.js\"",
    "backfill": "node src/backfill.js --incremental",
    "backfill:all": "node src/backfill.js",
    "backfill:adverts": "node src/backfill.js --adverts",
    "export-json": "node src/exportJson.js",
    "member-stats": "node src/memberStats.js",
    "member-stats:catchup": "node src/memberStats.js --incremental",
    "backfill:ages": "node src/memberAges.js",
    "check-links": "node src/checkLinks.js",
    "label:dry": "node src/advertLabeller.js --dry-run",
    "label:once": "node src/advertLabeller.js --once",
    "label:all": "node src/advertLabeller.js --all",
    "label:status": "node src/advertLabeller.js --status"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "discord.js": "^14.26.5",
    "dotenv": "^16.4.5",
    "pg": "^8.13.1",
    "sharp": "^0.34.5"
  },
  "overrides": {
    "undici": "^6.27.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8"
  }
}
