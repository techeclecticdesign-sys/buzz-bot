{
  "name": "rpc-logger-bot",
  "version": "1.0.0",
  "description": "Discord message archive + edit/delete logging bot with permanent database storage",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "backfill": "node src/backfill.js --incremental",
    "backfill:all": "node src/backfill.js",
    "backfill:adverts": "node src/backfill.js --adverts",
    "export-json": "node src/exportJson.js",
    "check-links": "node src/checkLinks.js",
    "migrate:supabase": "node scripts/migrate-to-supabase.js"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "discord.js": "^14.26.5",
    "dotenv": "^16.4.5",
    "pg": "^8.13.1"
  },
  "overrides": {
    "undici": "^6.27.0"
  }
}
